      [ member? species_init[ "Swamp Shrubland" ] ]

  set Swamp_Woodland_patches patches with
      [ member? species_init[ "Swamp Woodland" ] ]

  set Hardwood_Woodland_patches patches with
      [ member? species_init[ "Hardwood Woodland" ] ]

