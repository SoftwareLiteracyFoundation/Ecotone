  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="msl-drown-propagule" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>setup
let runlabel (word "OW" msl-open-depth "-PG" depth-propagule)
set view-label (word "EDM-" runlabel "-")
set timeseries-file (word "EDM-" runlabel ".csv")</setup>
      <go>go</go>
      <constants>
        <steppedValueSet variable="depth-propagule" first="5" step="2" last="15"></steppedValueSet>
        <steppedValueSet variable="msl-open-depth" first="50" step="10" last="90"></steppedValueSet>
      </constants>
    </experiment>
  </experiments>
</model>
